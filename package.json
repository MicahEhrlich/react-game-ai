{
  "name": "glitch-shift-arcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate-modes": "node --experimental-strip-types scripts/validate-modes.ts",
    "validate-director": "node --experimental-strip-types scripts/validate-director.ts",
    "validate-runner": "node --experimental-strip-types scripts/validate-runner.ts",
    "validate-llm-director": "node --experimental-strip-types scripts/validate-llm-director.ts",
    "validate-levels": "node --experimental-strip-types scripts/validate-levels.ts",
    "validate-brick": "node --experimental-strip-types scripts/validate-brick.ts",
    "validate-meme-theme": "node --experimental-strip-types scripts/validate-meme-theme.ts",
    "validate-trend-seeds": "node --experimental-strip-types scripts/validate-trend-seeds.ts",
    "validate-music": "node --experimental-strip-types scripts/validate-music.ts",
    "validate-audio-settings": "node --experimental-strip-types scripts/validate-audio-settings.ts",
    "validate-phase-damage": "node --experimental-strip-types scripts/validate-phase-damage.ts",
    "validate-input-mapping": "node --experimental-strip-types scripts/validate-input-mapping.ts",
    "gen-levels": "node --experimental-strip-types scripts/gen-levels.ts",
    "validate": "npm run validate-modes && npm run validate-director && npm run validate-runner && npm run validate-llm-director && npm run validate-levels && npm run validate-brick && npm run validate-meme-theme && npm run validate-trend-seeds && npm run validate-music && npm run validate-audio-settings && npm run validate-phase-damage && npm run validate-input-mapping"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
